# Required
SESSION_SECRET=change-me-to-a-random-string

# Database
DATABASE_URL=postgres://kariz:kariz@localhost:5432/kariz?sslmode=disable

# Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Application
APP_PORT=8080
